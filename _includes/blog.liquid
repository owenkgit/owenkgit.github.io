<div class="blog-feed">
  {% for group in site.data.blog %}
    <div class="blog-group">
      <div class="blog-group-head">
        <i class="fa-solid {{ group.icon }}"></i>
        <span>{{ group.group }}</span>
        <span class="blog-count">{{ group.posts | size }}</span>
      </div>

      <div class="blog-list">
        {% for post in group.posts %}
          <a class="blog-card" href="{{ post.url }}" target="_blank" rel="noopener noreferrer">
            <span class="blog-title">{{ post.title }}</span>
            {% if post.blurb %}<span class="blog-blurb">{{ post.blurb }}</span>{% endif %}
            <i class="fa-solid fa-arrow-right blog-arrow"></i>
          </a>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
