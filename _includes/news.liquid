<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and site.announcements.limit %}
      {% assign news_limit = site.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    {% assign show_toggle = false %}
    {% if include.limit and news_size > news_limit %}
      {% assign show_toggle = true %}
    {% endif %}

    {% if show_toggle %}<input type="checkbox" id="news-toggle" class="news-toggle-checkbox">{% endif %}

    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in news %}
          <tr {% if forloop.index > news_limit %}class="news-extra"{% endif %}>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>

    {% if show_toggle %}
      <label for="news-toggle" class="news-more">
        <span class="news-more-show">show more <i class="fa-solid fa-chevron-down"></i></span>
        <span class="news-more-hide">show less <i class="fa-solid fa-chevron-up"></i></span>
      </label>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
