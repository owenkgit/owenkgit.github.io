---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>news</h2>
      <div style="margin-bottom: 2.5rem;">
        {% include news.liquid limit=true %}
      </div>
    {% endif %}

    <!-- Publications -->
    <h2>publications</h2>

    <div class="publications" style="margin-top: 2rem;">
      <!-- CorrectVLA -->
      <div class="row" style="margin-bottom: 2.5rem;">
        <div class="col-sm-4">
          <div class="pub-thumb">
            <video controls playsinline autoplay muted loop>
              <source src="/assets/img/CorrectVLA_demo.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
        <div class="col-sm-8">
          <div style="margin-bottom: 0.5rem;">
            <strong><a href="https://correctvla.github.io/" target="_blank" rel="noopener noreferrer" style="font-size: 1.1rem;">Training-Free Action Correction for VLA Model Failures via Language Feedback</a></strong>
          </div>
          <div style="color: #666; margin-bottom: 0.25rem;">Owen Kwon, .., Jean Oh</div>
          <div style="color: #999; font-size: 0.95rem; margin-bottom: 0.25rem;">arXiv 2026</div>
          <div style="font-size: 0.9rem;">
            <a href="https://correctvla.github.io/" target="_blank" rel="noopener noreferrer">website</a>
          </div>
        </div>
      </div>

      <!-- RIO -->
      <div class="row" style="margin-bottom: 2.5rem;">
        <div class="col-sm-4">
          <div class="pub-thumb">
            <video controls playsinline autoplay muted loop>
              <source src="/assets/img/RIO_overview.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
        <div class="col-sm-8">
          <div style="margin-bottom: 0.5rem;">
            <strong><a href="https://robot-i-o.github.io/" target="_blank" rel="noopener noreferrer" style="font-size: 1.1rem;">RIO: Flexible Real-Time Robot I/O for Cross-Embodiment Robot Learning</a></strong>
          </div>
          <div style="color: #666; margin-bottom: 0.25rem;">Pablo Ortega-Kral, Eliot Xing, Arthur Fender Coelho Bucker, .., Owen Kwon, .., Jean Oh</div>
          <div style="color: #999; font-size: 0.95rem; margin-bottom: 0.25rem;">Robotics: Science and Systems (RSS) 2026</div>
          <div style="font-size: 0.9rem;">
            <a href="https://robot-i-o.github.io/" target="_blank" rel="noopener noreferrer">website</a> ·
            <a href="https://github.com/robot-i-o/rio" target="_blank" rel="noopener noreferrer">code</a>
          </div>
        </div>
      </div>

      <!-- RT-Cache -->
      <div class="row" style="margin-bottom: 2.5rem;">
        <div class="col-sm-4">
          <div class="pub-thumb pub-thumb-contain">
            <video controls playsinline autoplay muted loop>
              <source src="/assets/img/RT-Cache_Training-Free Retrieval for Real-Time Manipulation_video.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
        <div class="col-sm-8">
          <div style="margin-bottom: 0.5rem;">
            <strong><a href="https://rt-cache.github.io/" target="_blank" rel="noopener noreferrer" style="font-size: 1.1rem;">RT-Cache: Training-Free Retrieval for Real-Time Manipulation</a></strong>
          </div>
          <div style="color: #666; margin-bottom: 0.25rem;">Owen Kwon, Abraham George, Alison Bartsch, Amir Barati Farimani</div>
          <div style="color: #999; font-size: 0.95rem; margin-bottom: 0.25rem;">IEEE-RAS International Conference on Humanoid Robots (Humanoids) 2025 — <span style="color: #d9534f; font-weight: bold;">Contributed Paper</span></div>
          <div style="font-size: 0.9rem;">
            <a href="https://rt-cache.github.io/" target="_blank" rel="noopener noreferrer">website</a>
          </div>
        </div>
      </div>

      <!-- Patient deterioration detection -->
      <div class="row" style="margin-bottom: 2.5rem;">
        <div class="col-sm-4">
          <div class="pub-thumb">
            <img src="/assets/img/Continuous Time-series Prediction_dewimage.png">
          </div>
        </div>
        <div class="col-sm-8">
          <div style="margin-bottom: 0.5rem;">
            <strong style="font-size: 1.1rem;">Detecting patient deterioration using artificial intelligence in a rapid response system</strong>
          </div>
          <div style="color: #666; margin-bottom: 0.25rem;">KJ Cho, Owen Kwon, .., BH Oh</div>
          <div style="color: #999; font-size: 0.95rem; margin-bottom: 0.25rem;">Critical Care Medicine 48 (4), e285-e289</div>
        </div>
      </div>

      <!-- Subject-Independent BCI -->
      <div class="row" style="margin-bottom: 2.5rem;">
        <div class="col-sm-4">
          <div class="pub-thumb">
            <img src="/assets/img/Subject-Independent Brain-Computer Interfaces Based on Deep Convolutional Neural Networks.png">
          </div>
        </div>
        <div class="col-sm-8">
          <div style="margin-bottom: 0.5rem;">
            <strong style="font-size: 1.1rem;">Subject-Independent Brain-Computer Interfaces Based on Deep Convolutional Neural Networks</strong>
          </div>
          <div style="color: #666; margin-bottom: 0.25rem;">Owen Kwon, et al.</div>
          <div style="color: #999; font-size: 0.95rem; margin-bottom: 0.25rem;">IEEE Transactions on Neural Networks and Learning Systems (T-NNLS), 2019 — <span style="color: #d9534f; font-weight: bold;">Impact: Top 0.97%</span></div>
        </div>
      </div>

      <!-- BCI Open Source -->
      <div class="row" style="margin-bottom: 2.5rem;">
        <div class="col-sm-4">
          <div class="pub-thumb">
            <img src="/assets/img/opensource.png">
          </div>
        </div>
        <div class="col-sm-8">
          <div style="margin-bottom: 0.5rem;">
            <strong style="font-size: 1.1rem;">EEG dataset and OpenBMI toolbox for three BCI paradigms: An investigation into BCI illiteracy</strong>
          </div>
          <div style="color: #666; margin-bottom: 0.25rem;">MH Lee, Owen Kwon, .., S Fazli</div>
          <div style="color: #999; font-size: 0.95rem; margin-bottom: 0.25rem;">GigaScience 8 (5), giz002</div>
        </div>
      </div>
    </div>

    <!-- Blog -->
    {% if site.data.blog %}
      <h2>blog</h2>
      <div style="margin-bottom: 2.5rem;">
        {% include blog.liquid limit=6 %}
      </div>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
